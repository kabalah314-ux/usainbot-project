# Copia este archivo a .env.local (o configúralo en Vercel) y ajusta los valores.

# URL del servidor de guardado en la nube (opción A).
# Vacío o ausente → el guardado se queda en localStorage y el botón
# "CONECTAR WALLET" no aparece en el menú de pausa.
# Local:  VITE_SAVE_API=http://localhost:8787
# Producción: VITE_SAVE_API=https://tu-dominio.example
VITE_SAVE_API=
